import cv2
import matplotlib.pyplot as plt
from google.colab import files

# Upload an image containing text
print("Upload an image with printed text")
uploaded = files.upload()

# Read image
image_path = list(uploaded.keys())[0]
image = cv2.imread(image_path)

# Convert BGR to RGB
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

# Image Acquisition - Convert to Grayscale
gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

# Sampling - Resize image (improves OCR readability)
resized = cv2.resize(gray, None, fx=2, fy=2, interpolation=cv2.INTER_CUBIC)

# Noise Removal
blur = cv2.GaussianBlur(resized, (5,5), 0)

# Quantization - Binary Thresholding
_, binary = cv2.threshold(blur, 0, 255,
                          cv2.THRESH_BINARY + cv2.THRESH_OTSU)

# Display Results
titles = ['Original Image',
          'Grayscale',
          'Resized (Sampling)',
          'Binary Image (Quantization)']

images = [image_rgb, gray, resized, binary]

plt.figure(figsize=(12,8))

for i in range(4):
    plt.subplot(2,2,i+1)
    if len(images[i].shape) == 2:
        plt.imshow(images[i], cmap='gray')
    else:
        plt.imshow(images[i])
    plt.title(titles[i])
    plt.axis('off')

plt.tight_layout()
plt.show()

print("OCR Image Preprocessing Completed Successfully!")
