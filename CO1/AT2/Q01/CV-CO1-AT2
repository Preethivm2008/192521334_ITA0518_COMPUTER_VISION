import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage import data
from skimage.metrics import peak_signal_noise_ratio as psnr
from skimage.metrics import structural_similarity as ssim

# Load sample image
image = data.astronaut()
image = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)

# Simulate CCD Image (Less Noise)
ccd_noise = np.random.normal(0, 5, image.shape).astype(np.int16)
ccd_image = np.clip(image.astype(np.int16) + ccd_noise, 0, 255).astype(np.uint8)

# Simulate CMOS Image (More Noise)
cmos_noise = np.random.normal(0, 15, image.shape).astype(np.int16)
cmos_image = np.clip(image.astype(np.int16) + cmos_noise, 0, 255).astype(np.uint8)

# Calculate PSNR
psnr_ccd = psnr(image, ccd_image)
psnr_cmos = psnr(image, cmos_image)

# Calculate SSIM
ssim_ccd = ssim(image, ccd_image)
ssim_cmos = ssim(image, cmos_image)

# Display Results
plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(image, cmap='gray')
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(ccd_image, cmap='gray')
plt.title(f"CCD Image\nPSNR={psnr_ccd:.2f}\nSSIM={ssim_ccd:.3f}")
plt.axis("off")

plt.subplot(1,3,3)
plt.imshow(cmos_image, cmap='gray')
plt.title(f"CMOS Image\nPSNR={psnr_cmos:.2f}\nSSIM={ssim_cmos:.3f}")
plt.axis("off")

plt.show()

# Print Comparison
print("----- Image Quality Comparison -----")
print(f"CCD  -> PSNR: {psnr_ccd:.2f} dB, SSIM: {ssim_ccd:.3f}")
print(f"CMOS -> PSNR: {psnr_cmos:.2f} dB, SSIM: {ssim_cmos:.3f}")

if psnr_ccd > psnr_cmos:
    print("\nResult: CCD provides better image quality with less noise.")
else:
    print("\nResult: CMOS provides better image quality.")
