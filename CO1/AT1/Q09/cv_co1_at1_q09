import cv2
import numpy as np
import matplotlib.pyplot as plt

# ----------------------------------------
# Step 1: Low-Level Vision (Image Acquisition)
# ----------------------------------------

# Create a simple face-like image
image = np.ones((400, 400, 3), dtype=np.uint8) * 255

# Face
cv2.circle(image, (200, 200), 100, (255, 220, 180), -1)

# Eyes
cv2.circle(image, (170, 170), 10, (0, 0, 0), -1)
cv2.circle(image, (230, 170), 10, (0, 0, 0), -1)

# Mouth
cv2.ellipse(image, (200, 230), (40, 20), 0, 0, 180, (0,0,255), 3)

# ----------------------------------------
# Step 2: Mid-Level Vision (Face Detection)
# ----------------------------------------

detected = image.copy()
cv2.rectangle(detected, (100,100), (300,300), (0,255,0), 3)
cv2.putText(detected, "Face Detected", (105,90),
            cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0,255,0), 2)

# ----------------------------------------
# Step 3: High-Level Vision (Recognition)
# ----------------------------------------

recognized = detected.copy()
cv2.putText(recognized, "Identity: Person A", (95,340),
            cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255,0,0), 2)

# ----------------------------------------
# Display Images
# ----------------------------------------

plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))
plt.title("Low-Level Vision\nImage Acquisition")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(cv2.cvtColor(detected, cv2.COLOR_BGR2RGB))
plt.title("Mid-Level Vision\nFace Detection")
plt.axis("off")

plt.subplot(1,3,3)
plt.imshow(cv2.cvtColor(recognized, cv2.COLOR_BGR2RGB))
plt.title("High-Level Vision\nRecognition")
plt.axis("off")

plt.show()

# ----------------------------------------
# Explanation
# ----------------------------------------

print("FACIAL RECOGNITION USING COMPUTER VISION")
